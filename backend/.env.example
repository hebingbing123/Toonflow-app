PORT=8666

# Enterprise workspaces owned by a user: max **active** (non-archived) rows; `POST /api/v1/workspaces` returns **429** when exceeded. Default **50**.
# TOONFLOW_MAX_ENTERPRISE_WORKSPACES_PER_USER=50
# Workspace member/invite write actions per workspace per hour (`POST /members`, `POST /invites`), default **120**.
# TOONFLOW_WORKSPACE_MEMBER_MUTATIONS_PER_HOUR=120

# Compile-time only (must be set when running `cargo build` / `cargo run`, not loaded from this file at runtime):
# TOONFLOW_GIT_SHA=abc123   # optional; embedded into GET /api/v1/version as `git_sha`

# Per-IP HTTP rate limit (see backend/README.md). Behind a trusted reverse proxy, set to 1 to key off Forwarded / X-Forwarded-For.
# RATE_LIMIT_TRUST_FORWARDED_HEADERS=1
# RATE_LIMIT_REFILL_MS=20
# RATE_LIMIT_BURST=100
# From `supabase status` after `supabase start` (Database settings → URI), or hosted project settings.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:64322/postgres
# JWT secret: local `supabase status` → JWT secret; hosted → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# HMAC for POST /api/v1/webhooks/billing (X-Toonflow-Signature: sha256=<hex>); omit to disable webhook ingestion (503).
# BILLING_WEBHOOK_SECRET=
# Toonflow native scheme: optional X-Toonflow-Timestamp + HMAC("<ts>." + body); tolerance and strict mode:
# BILLING_TOONFLOW_TOLERANCE_SECS=300
# BILLING_TOONFLOW_REQUIRE_TIMESTAMP=1

# GET /api/v1/webhooks/billing/events reads the global audit table; the server returns 403 unless this is exactly "1".
# Local template: enabled for dev convenience. Production / shared tenants: remove this line or set to 0.
BILLING_WEBHOOK_EVENTS_LIST_ENABLED=1

# Job worker instance label (stored in app_generation_job.claimed_by when running; default "default").
# WORKER_ID=worker-1

# Structured log interval for PG queue depth (pending/running/dead). Default 60; set to 0 to disable.
# JOB_QUEUE_METRICS_INTERVAL_SECS=60

# Optional: restrict which WebSocket agent channels may attach (comma-separated: script, production). Unset = allow both.
# HARNESS_WS_CHANNELS=script,production

# OpenAI-compatible Chat Completions (streaming) for WebSocket agent.chat.send
# OPENAI_API_KEY=sk-...
# Optional: LLM_API_KEY (alias), OPENAI_BASE_URL (default https://api.openai.com/v1), LLM_MODEL (default gpt-4o-mini)
# Image jobs (asset.generate.image / asset.generate.batch) use the same key against {OPENAI_BASE_URL}/v1/images/generations.
# Optional: TOONFLOW_IMAGE_MODEL (default dall-e-3) when the HTTP body model string does not contain dall-e-2 / dall-e-3.
# Optional: TOONFLOW_LOCAL_ASSET_IMAGE_DIR=/path/to/dir — asset.generate.* workers save PNGs as {dir}/{user_uuid}/{image_row_id}.png
# and set app_asset_image.file_path to GET …/images/{id}/file (metadata.storage=local, metadata.provider_url = temp URL).

# SQLite → PG staging (`cargo run --bin toonflow-sqlite-import`)
# SQLITE_PATH=/path/to/db2.sqlite
# LEGACY_IMPORT_TRUNCATE=1
