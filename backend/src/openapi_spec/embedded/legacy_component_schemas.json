    ],
    "description": "Legacy checkUpdate **`source`** field"
  },
  "ReadyResponse": {
    "type": "object",
    "required": [
      "status",
      "database"
    ],
    "properties": {
      "status": {
        "type": "string",
        "example": "ok"
      },
      "database": {
        "type": "string",
        "enum": [
          "not_configured",
          "connected"
        ],
        "description": "`not_configured` when `DATABASE_URL` is unset"
      }
    }
  },
  "MeResponse": {
    "type": "object",
    "required": [
      "sub",
      "plan_tier"
    ],
    "properties": {
      "sub": {
        "type": "string",
        "format": "uuid",
        "description": "Supabase Auth user id (`JWT sub`)"
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Present when included in JWT claims"
      },
      "plan_tier": {
        "type": "string",
        "description": "From `app_user_profile`; `free` when DATABASE_URL is unset or no row exists"
      },
      "billing_currency": {
        "type": "string",
        "nullable": true
      },
      "billing_provider": {
        "type": "string",
        "nullable": true
      },
      "subscription_status": {
        "type": "string",
        "nullable": true,
        "description": "Normalized subscription status from profile (`active`, `past_due`, etc.)"
      },
      "subscription_current_period_end_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "Current paid subscription period end (when known)"
      },
      "daily_job_quota": {
        "type": "integer",
        "format": "int64",
        "nullable": true,
        "description": "Effective daily generation-job cap for this user (UTC natural day).\n`null` = unlimited (enterprise tier or per-user override set to unlimited).\nDerived from `plan_tier` defaults or `app_user_profile.daily_job_quota` override.\nAbsent when `DATABASE_URL` is unset (falls back to free-tier default in that case).\n"
      },
      "jobs_today": {
        "type": "integer",
        "format": "int64",
        "nullable": true,
        "description": "Number of generation jobs created today (UTC midnight to now).\nAbsent when `DATABASE_URL` is unset.\n"
      },
      "memory_config": {
        "$ref": "#/components/schemas/MemoryConfig",
        "nullable": true,
        "description": "User memory/RAG configuration from `app_user_profile.memory_config`.\nPresent when row exists and has non-null JSON; absent when unset.\nWhen DATABASE_URL is unset, falls back to server defaults (same as `GET /api/v1/settings/memory-config`).\n"
      }
    }
  },
  "UsageSummaryResponse": {
    "type": "object",
    "required": [
      "events_last_24h",
      "events_last_7d",
      "event_counts_last_7d",
      "jobs_today",
      "daily_job_quota"
    ],
    "properties": {
      "events_last_24h": {
        "type": "integer",
        "format": "int64",
        "description": "Rows in `app_usage_event` in the rolling last 24 hours"
      },
      "events_last_7d": {
        "type": "integer",
        "format": "int64",
        "description": "Rows in `app_usage_event` in the rolling last 7 days"
      },
      "event_counts_last_7d": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "format": "int64"
        },
        "description": "Per `event_type` counts in the rolling last 7 days (empty object when no rows)"
      },
      "jobs_today": {
        "type": "integer",
        "format": "int64",
        "description": "Generation jobs created today (UTC natural day) — same counter used by quota enforcement"
      },
      "daily_job_quota": {
        "type": "integer",
        "format": "int64",
        "nullable": true,
        "description": "Effective daily job cap for this user (`null` = unlimited, e.g. enterprise tier)"
      },
      "quota_remaining": {
        "type": "integer",
        "format": "int64",
        "nullable": true,
        "description": "Remaining jobs allowed today (`null` = unlimited). `0` means quota is exhausted.\nAbsent when `daily_job_quota` is `null`.\n"
      }
    }
  },
