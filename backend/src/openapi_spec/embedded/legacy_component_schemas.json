{
  "HealthResponse": {
    "type": "object",
    "required": [
      "status",
      "service"
    ],
    "properties": {
      "status": {
        "type": "string",
        "example": "ok"
      },
      "service": {
        "type": "string",
        "example": "toonflow-server"
      }
    }
  },
  "PingResponse": {
    "type": "object",
    "required": [
      "ok"
    ],
    "properties": {
      "ok": {
        "type": "boolean",
        "example": true
      }
    }
  },
  "VersionResponse": {
    "type": "object",
    "required": [
      "service",
      "version"
    ],
    "properties": {
      "service": {
        "type": "string",
        "example": "toonflow-server"
      },
      "version": {
        "type": "string",
        "description": "Rust crate / binary version (`CARGO_PKG_VERSION`)"
      },
      "git_sha": {
        "type": "string",
        "description": "Optional. Embedded at **compile time** when `TOONFLOW_GIT_SHA` was set for `cargo build` / `cargo test` (not read from runtime `.env`).\n"
      }
    }
  },
  "MemoryConfig": {
    "type": "object",
    "description": "Legacy `o_setting` keys for memory / RAG UI (camelCase JSON); also embedded in `GET /api/v1/me` as `memory_config`.",
    "required": [
      "messagesPerSummary",
      "shortTermLimit",
      "summaryMaxLength",
      "summaryLimit",
      "ragLimit",
      "deepRetrieveSummaryLimit",
      "modelOnnxFile",
      "modelDtype"
    ],
    "properties": {
      "messagesPerSummary": {
        "type": "integer",
        "format": "int64",
        "description": "Number of messages before triggering a summary"
      },
      "shortTermLimit": {
        "type": "integer",
        "format": "int64",
        "description": "Short-term memory window size"
      },
      "summaryMaxLength": {
        "type": "integer",
        "format": "int64",
        "description": "Maximum tokens per summary"
      },
      "summaryLimit": {
        "type": "integer",
        "format": "int64",
        "description": "Maximum number of summaries to retain"
      },
      "ragLimit": {
        "type": "integer",
        "format": "int64",
        "description": "Top-K retrieved chunks for RAG context"
      },
      "deepRetrieveSummaryLimit": {
        "type": "integer",
        "format": "int64",
        "description": "Top-K summaries for deep retrieval"
      },
      "modelOnnxFile": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Path segments to ONNX embedding model"
      },
      "modelDtype": {
        "type": "string",
        "description": "ONNX model data type (fp16/fp32)"
      }
    }
  },
  "VendorSummaryItem": {
    "type": "object",
    "required": [
      "id",
      "name",
      "modelCount",
      "modelKinds"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int32",
        "description": "Vendor ID from static catalog"
      },
      "name": {
        "type": "string"
      },
      "modelCount": {
        "type": "integer",
        "format": "int32"
      },
      "modelKinds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "userConfig": {
        "$ref": "#/components/schemas/VendorConfigEntry",
        "description": "User configuration for this vendor (if any)"
      }
    }
  },
  "VendorConfigEntry": {
    "type": "object",
    "required": [
      "vendorId"
    ],
    "properties": {
      "vendorId": {
        "type": "string",
        "description": "Vendor ID from the static catalog"
      },
      "displayName": {
        "type": "string",
        "nullable": true,
        "description": "User-defined display name override"
      },
      "enabled": {
        "type": "boolean",
        "description": "Whether this vendor is enabled for this user"
      },
      "selectedModels": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Selected model IDs from this vendor"
      },
      "settings": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "description": "Additional non-sensitive config (API keys excluded)"
      }
    }
  },
  "VendorMutationResponse": {
    "type": "object",
    "required": [
      "vendorId",
      "message"
    ],
    "properties": {
      "vendorId": {
        "type": "string",
        "description": "Vendor ID that was created, updated, or deleted"
      },
      "message": {
        "type": "string",
        "description": "Confirmation message"
      }
    }
  },
  "ScriptAgentTypeV1": {
