{
  "name": "toonflow",
  "version": "1.0.9",
  "description": "Toonflow 是一款 AI 短剧漫剧工具，能够利用 AI 技术将小说自动转化为剧本，并结合 AI 生成的图片和视频，实现高效的短剧创作。",
  "author": "HBAI-Ltd <ltlctools@outlook.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/HBAI-Ltd/Toonflow-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HBAI-Ltd/Toonflow-app.git"
  },
  "bugs": {
    "url": "https://github.com/HBAI-Ltd/Toonflow-app/issues",
    "email": "ltlctools@outlook.com"
  },
  "packageManager": "yarn@1.0.0",
  "engines": {
    "node": ">=1.0.0"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "refactor:agent": "bash scripts/agent-refactor-check.sh",
    "refactor:check": "bash scripts/refactor-check.sh",
    "refactor:quick": "bash scripts/refactor-check.sh --quick",
    "refactor:incremental": "bash scripts/refactor-check.sh --incremental",
    "rust:target:report": "bash scripts/rust-target-maintenance.sh report",
    "rust:target:clean": "bash scripts/rust-target-maintenance.sh clean"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {}
}
